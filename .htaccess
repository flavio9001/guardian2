Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /         ← mude de /sgs/ para /

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^api/(.*)$ api.php?path=$1 [QSA,L]
</IfModule>

<FilesMatch "^(db_config\.php|db\.json|dev-server\.mjs|diagnostico\.php|diag_debug\.php)$">
  Require all denied
</FilesMatch>